{
  "name": "living-sometimes-engine",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "test": "tsx --test tests/*.test.ts",
    "pretypecheck": "node tools/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "policy": "node tools/policy.mjs",
    "policy:archive": "node tools/policy.mjs --require-archive",
    "build": "node tools/build.mjs",
    "new": "node tools/new-project.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run policy",
    "format": "prettier --write --ignore-unknown core modules studio projects tools tests package.json tsconfig.json"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "0.185.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tally-DE/living-sometimes-engine.git"
  }
}
